# Beatrice · Base de datos PROPIA (separada de ddai-web y de otras apps del server)
DATABASE_URL="postgresql://beatrice_app:CAMBIA_ESTO@HOST:5432/beatrice?schema=public"

# Token para autenticar la ingesta de resultados de CI (POST /api/runs)
# Genera uno fuerte:  openssl rand -hex 32
INGEST_TOKEN="pon_un_token_largo_y_secreto_aqui"

# (Futuro) Proveedor de IA. Por defecto usa el motor heurístico determinista (sin API key).
# BEATRICE_AI_PROVIDER="heuristic"
