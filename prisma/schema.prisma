// QA Console · esquema de datos
// Vive en su PROPIA base de datos (qaconsole), separada de ddai-web.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id        String   @id @default(cuid())
  slug      String   @unique          // ej: "playwright-api"
  name      String
  createdAt DateTime @default(now())
  runs      Run[]
}

model Run {
  id         String   @id @default(cuid())
  externalId String                    // ej: "run-0042" (del CI)
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String
  timestamp  DateTime @default(now())
  durationMs Int      @default(0)
  passed     Int      @default(0)
  failed     Int      @default(0)
  skipped    Int      @default(0)
  flaky      Int      @default(0)
  suites     Json                       // [{ name, tests: [{title,status,durationMs,error}] }]
  createdAt  DateTime @default(now())

  @@index([projectId, timestamp])
}
